# ========== 日志配置 ==========
# 可选: DEBUG / INFO / WARNING / ERROR / CRITICAL
WORDAGENT_LOG_LEVEL=INFO

# LangSmith 监控配置（可选，不配置不影响项目运行）
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_api_key_here
LANGSMITH_PROJECT=WordAgent

# LangSmith 评估配置（可选，不配置不影响项目运行）
LANGSMITH_EVALUATION_PROJECT=WordAgent_evaluation
LANGSMITH_DATASET_NAME=WordAgent_dataset
EVAL_OPENAI_MODEL=gpt-5.5
EVAL_OPENAI_API_KEY=your_api_key_here
EVAL_OPENAI_BASE_URL=https://api.openai.com/v1
EVAL_CONCURRENCY=5

# ========== Agent 轮次控制 ==========
# Agent 总轮次上限（每轮 = 1次 LLM 调用，无论是否调用工具，默认 100）
WORDAGENT_AGENT_RECURSION_LIMIT=100

# ========== WebSocket 空闲监控 ==========
# 连续多少秒没有流式 chunk 时向前端提示“正在思考”
WORDAGENT_IDLE_WARN_SECONDS=100
# 连续多少秒没有流式 chunk 时终止 Agent 并断开 WebSocket；必须大于提示阈值
WORDAGENT_IDLE_ABORT_SECONDS=300

# ========== 工具失败重试 ==========
# 首次调用失败后的最大重试次数；2 表示工具最多调用 3 次
WORDAGENT_TOOL_MAX_RETRIES=2
# 指数退避因子
WORDAGENT_TOOL_RETRY_BACKOFF_FACTOR=2.0
# 首次重试前的延迟（秒）
WORDAGENT_TOOL_RETRY_INITIAL_DELAY=1.0
# 单次重试的最大延迟（秒）
WORDAGENT_TOOL_RETRY_MAX_DELAY=10.0
# 模型返回 invalid_tool_calls 时，要求模型重新生成合法工具参数的次数
WORDAGENT_INVALID_TOOL_CALL_MAX_RETRIES=2

# ========== MCP 输出防膨胀 ==========
# 前端展示的 MCP 结果预览最大字符数
WORDAGENT_MCP_PREVIEW_MAX_CHARS=100000
# 注入给模型的 MCP 工具结果最大字符数
WORDAGENT_MCP_MODEL_MAX_CHARS=100000
# MCP 工具调用超时时间（秒），默认 300 秒
WORDAGENT_MCP_TOOL_TIMEOUT=300

# ========== 上传文件处理配置 ==========
# 注入到 LLM 上下文的文本最大字符数（约 25K tokens）
MAX_TEXT_CHARS=50000

# ========== 官方上下文摘要中间件 ==========
# 模型总上下文窗口（token，默认258k）
WORDAGENT_MAX_CONTEXT_TOKENS=258000
# 达到总上下文窗口的 93% 时触发摘要
WORDAGENT_HEAVY_COMPACT_TRIGGER_PCT=93
# 摘要后保留最近消息，目标为总上下文窗口的 8%
WORDAGENT_HEAVY_COMPACT_KEEP_PCT=8

# ========== 长期记忆 ==========
# 长期记忆提取 LLM 的 temperature（默认 0.1，更确定性）
WORDAGENT_MEMORY_EXTRACT_TEMPERATURE=0.1
# 长期记忆最大条数
WORDAGENT_MEMORY_MAX_ITEMS=20
